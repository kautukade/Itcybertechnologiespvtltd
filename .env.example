# ── Supabase (NEVER commit real values; service-role key must NEVER appear in frontend code) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Public site URL (used for canonical tags, sitemap and CORS) ──
VITE_SITE_URL=https://www.itcyber.in

# ── Optional company contact defaults (override at runtime via Admin → Settings) ──
# Leave empty to gracefully hide phone/WhatsApp CTAs until configured in the admin panel.
VITE_COMPANY_EMAIL=
VITE_SALES_EMAIL=
VITE_CAREERS_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_PHONE_DISPLAY=

# ── Optional analytics (leave empty to keep inactive — no fake IDs) ──
VITE_GA_ID=
VITE_META_PIXEL_ID=
VITE_LINKEDIN_ID=
